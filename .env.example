# ---- Server ----
PORT=3000
# Long random string used to sign login tokens. CHANGE THIS in production.
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# mysql  -> uses the MySQL settings below (production setup)
# sqlite -> zero-setup file database (great for demos / judging laptops)
DB_CLIENT=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=buildbid

# Used only when DB_CLIENT=sqlite
SQLITE_FILE=./data/buildbid.sqlite
